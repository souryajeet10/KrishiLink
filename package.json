    "migrate:status": "node src/migrations/run_migrations.js status",
    "seed": "node src/migrations/seed.js",
    "test": "node test_api.js && node test_e2e_flow.js && node test_razorpay.js && node test_voice.js",
    "test:api": "node test_api.js",
    "test:e2e": "node test_e2e_flow.js",
    "test:razorpay": "node test_razorpay.js",
    "test:voice": "node test_voice.js"
  },
  "keywords": [
    "krishilink",
    "agriculture",
    "marketplace",
    "enam",
    "postgis",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pg": "^8.13.3",
    "razorpay": "^2.9.8"
  }
