  "description": "KrishiLink – AI Agri-Market Intelligence Platform Backend & App",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "migrate": "node src/migrations/run_migrations.js up",
