# ==============================================================================
# KrishiLink – Environment Variables Specification
# Copy this file to .env and populate with your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5173
NODE_ENV=development
# Allowed CORS origins (comma-separated or * for all in development)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection Settings (Render / Railway / Neon / Local)
# ------------------------------------------------------------------------------
# Preferred full connection string format:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krishilink
# Set to true when deploying on cloud providers requiring SSL (Render, Railway, Neon)
PGSSL=false

# Optional individual fallback parameters (used if DATABASE_URL is commented out):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=krishilink
# PG_POOL_MAX=20

# PostGIS extension auto-detection flag
ENABLE_POSTGIS=true

# ------------------------------------------------------------------------------
# 3. Redis Cache Settings (Render Redis / Upstash / Railway Redis / Local)
# ------------------------------------------------------------------------------
# In-memory LRU cache fallback automatically activates if Redis is unreachable
REDIS_URL=redis://localhost:6379
# Cache TTL in seconds (10800s = 3 hours for daily mandi rate updates)
REDIS_CACHE_TTL=10800

# ------------------------------------------------------------------------------
# 4. Firebase Admin SDK & Cloud Messaging (FCM) Credentials
# ------------------------------------------------------------------------------
# Option A: Individual environment variables (Recommended for Render, Railway, Vercel)
FIREBASE_PROJECT_ID=krishilink-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@krishilink-dev.iam.gserviceaccount.com
# Use literal private key or \n escaped string from your Firebase Service Account JSON:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"

# Option B: Path to Service Account JSON file (Alternative for local development):
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Development & Test Mode Flag:
# Set to 'true' to allow simulated offline tokens and mock FCM delivery when running tests or offline
FIREBASE_DEV_MODE=true

# ------------------------------------------------------------------------------
# 5. Open Government Data (data.gov.in) AGMARKNET Mandi Price API
# ------------------------------------------------------------------------------
# Obtain your free API key by registering at: https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
# Resource ID for Current Daily Price and Arrival of Agricultural Commodities
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ------------------------------------------------------------------------------
# 6. Razorpay Standard Web Checkout Credentials
# ------------------------------------------------------------------------------
# Razorpay API Key ID (Public, test or live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Razorpay API Key Secret (Secret, server-side only)
# ------------------------------------------------------------------------------
# 7. OpenAI Whisper API Credentials (Voice-Assisted Sell Order Input)
# ------------------------------------------------------------------------------
# DEMO-GRADE: OpenAI Whisper API + lightweight dictionary parser for SIH prototype.
# PRODUCTION ROADMAP: Replace transcription with Bhashini ASR; replace regex parser
# with a trained NER model for produce/quantity/price extraction at scale.
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 8. Google Gemini API Credentials (Multilingual Order Parsing)
# ------------------------------------------------------------------------------
# Gemini API used for structured NLU extraction from transcribed speech.
# Regex/dictionary parser retained as fallback if Gemini call fails or times out.
GEMINI_API_KEY=your_gemini_api_key_here
